<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_odoo_accounting_cli_v3" model="ir.module.category">
        <field name="name">Odoo Accounting CLI V3</field>
        <field name="description">Technical identities for controlled V3 accounting writes.</field>
        <field name="sequence">95</field>
    </record>

    <record id="privilege_odoo_accounting_cli_v3" model="res.groups.privilege">
        <field name="name">Odoo Accounting CLI V3</field>
        <field name="description">Controlled execution and approval roles for V3 accounting writes.</field>
        <field name="sequence">95</field>
        <field name="category_id" ref="module_category_odoo_accounting_cli_v3"/>
    </record>

    <record id="group_executor" model="res.groups">
        <field name="name">V3 Accounting CLI Executor</field>
        <field name="privilege_id" ref="privilege_odoo_accounting_cli_v3"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="group_approver" model="res.groups">
        <field name="name">V3 Accounting CLI Approver</field>
        <field name="privilege_id" ref="privilege_odoo_accounting_cli_v3"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="operation_executor_company_rule" model="ir.rule">
        <field name="name">V3 operation: executor companies</field>
        <field name="model_id" ref="model_odoo_accounting_cli_operation"/>
        <field name="groups" eval="[(4, ref('group_executor'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="operation_approver_company_rule" model="ir.rule">
        <field name="name">V3 operation: approver companies</field>
        <field name="model_id" ref="model_odoo_accounting_cli_operation"/>
        <field name="groups" eval="[(4, ref('group_approver'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="approval_wizard_approver_company_rule" model="ir.rule">
        <field name="name">V3 approval review: creating approver and company</field>
        <field name="model_id" ref="model_odoo_accounting_cli_v3_approval_wizard"/>
        <field name="groups" eval="[(4, ref('group_approver'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
