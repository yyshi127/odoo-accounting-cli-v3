[Unit]
Description=Odoo Accounting CLI V3 Pi Bridge sidecar
Requires=odoo-accounting-cli-v3-pi-broker.socket
Requires=odoo-accounting-cli-v3-pi-bridge.socket
After=network-online.target
After=odoo-accounting-cli-v3-pi-broker.socket
After=odoo-accounting-cli-v3-pi-bridge.socket
Wants=network-online.target

[Service]
Type=simple
User=odoo-v3-pi-broker
Group=odoo-v3-pi-broker
SupplementaryGroups=odoo-v3-runtime
StateDirectory=odoo-accounting-cli-v3-pi-bridge
StateDirectoryMode=0700
EnvironmentFile=/etc/odoo-accounting-cli-v3/pi-bridge-v3.env
Environment=HOME=/var/lib/odoo-accounting-cli-v3-pi-bridge
Environment=PI_CODING_AGENT_DIR=/var/lib/odoo-accounting-cli-v3-pi-bridge/agent
Environment=PI_AGENT_SESSION_DIR=/var/lib/odoo-accounting-cli-v3-pi-bridge/sessions
Environment=PI_AGENT_BRIDGE_HOST=127.0.0.1
Environment=PI_AGENT_BRIDGE_PORT=18788
Environment=PI_BRIDGE_HARDENED_V3_ONLY=1
Environment=PI_BRIDGE_REQUIRE_V3_IDENTITY=1
Environment=PI_BRIDGE_REQUIRE_SYSTEMD_SOCKET=1
Environment=PI_BRIDGE_RUNTIME_ROOT=/opt/odoo-accounting-cli-v3/pi-runtime/@V3_RELEASE@/pi_bridge
Environment=ODOO_ACCOUNTING_CLI_V3_BROKER_SOCKET=/run/odoo-accounting-cli-v3/pi-broker.sock
Environment=PI_BRIDGE_AUTHENTICATED_SESSION_RESOLVER_MODULE=/opt/odoo-accounting-cli-v3/pi-runtime/@V3_RELEASE@/pi_bridge/odoo-session-header-resolver.mjs
UnsetEnvironment=NODE_OPTIONS NODE_PATH PYTHONHOME PYTHONPATH LD_AUDIT LD_LIBRARY_PATH LD_PRELOAD
WorkingDirectory=/opt/odoo-accounting-cli-v3/pi-runtime/@V3_RELEASE@/pi_bridge
Sockets=odoo-accounting-cli-v3-pi-bridge.socket
ExecStart=@V3_NODE@ /opt/odoo-accounting-cli-v3/releases/@V3_RELEASE@/pi_bridge/bootstrap.mjs /opt/odoo-accounting-cli-v3/pi-runtime/@V3_RELEASE@/pi_bridge
Restart=on-failure
RestartSec=5s
TimeoutStartSec=180s
TimeoutStopSec=150s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
