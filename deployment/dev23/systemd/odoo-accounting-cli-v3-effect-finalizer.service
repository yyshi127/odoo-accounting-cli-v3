[Unit]
Description=Odoo Accounting CLI V3 isolated effect finalizer
Requires=odoo-accounting-cli-v3-effect-finalizer.socket
After=odoo-accounting-cli-v3-effect-finalizer.socket

[Service]
Type=simple
User=odoo-v3-effect-finalizer
Group=odoo-v3-effect-finalizer
SupplementaryGroups=odoo-v3-runtime
StateDirectory=odoo-accounting-cli-v3-effect-finalizer
StateDirectoryMode=0700
Environment=HOME=/var/lib/odoo-accounting-cli-v3-effect-finalizer
UnsetEnvironment=PYTHONHOME PYTHONPATH PYTHONSTARTUP PYTHONINSPECT LD_AUDIT LD_LIBRARY_PATH LD_PRELOAD PGAPPNAME PGCHANNELBINDING PGCONNECT_TIMEOUT PGDATABASE PGHOST PGHOSTADDR PGPASSFILE PGPASSWORD PGPORT PGSERVICE PGSERVICEFILE PGSSLCERT PGSSLKEY PGSSLMODE PGSSLROOTCERT PGUSER PGOPTIONS
Sockets=odoo-accounting-cli-v3-effect-finalizer.socket
ExecStart=/opt/odoo-accounting-cli-v3/releases/@V3_RELEASE@/bin/odoo-accounting-cli-v3-effect-finalizer --config /etc/odoo-accounting-cli-v3/effect-finalizer-runtime.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=135s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
